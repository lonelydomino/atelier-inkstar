{
  "name": "atelier-inkstar",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter marketing dev",
    "dev:shop": "pnpm --filter shop dev",
    "dev:all": "pnpm --parallel --filter marketing --filter shop dev",
    "build": "pnpm --filter marketing build && pnpm --filter shop build",
    "build:marketing": "pnpm --filter marketing build",
    "build:shop": "pnpm --filter shop build",
    "lint": "pnpm --filter marketing lint && pnpm --filter shop lint",
    "start": "pnpm --filter marketing start",
    "start:shop": "pnpm --filter shop start"
  },
  "packageManager": "pnpm@11.8.0"
}
